# ─────────────────────────────────────────────────────────────────────────
# QuickHire backend — PostgreSQL-only env template.
#
# Use this to run the backend with ZERO Mongo dependency. Every read and
# write goes to Postgres via dualCollection's typed repos / generic JSONB
# mirror schema.
#
# Prerequisites BEFORE flipping these vars in production:
#   1. Postgres has been provisioned and reachable at PG_URL.
#   2. The 5 strict-schema tables (countries, currencies, services, users,
#      sessions) have been created and backfilled. Run once:
#         PG_URL=$PG_URL node src/scripts/pg-migrate.js
#   3. The 40+ generic-schema tables have been mirrored from existing
#      Mongo data (or seeded fresh). Run once:
#         PG_URL=$PG_URL node src/scripts/pg-mirror-all.js
#      pg-mirror-all auto-discovers Mongo collections and creates a
#      JSONB-shaped table for each one not in PHASE1_TABLES.
#   4. Run any data-shape migrations under db/migrations/*.sql against PG.
#
# Once PG holds the data, append/replace the following in your live .env:
# ─────────────────────────────────────────────────────────────────────────

# ── Disable Mongo entirely. db.js skips connection on any of:
#    'disabled' | 'skip' | 'none' | '' (empty)
MONGO_URI=disabled

# ── Postgres connection
PG_URL=postgres://USER:PASSWORD@HOST:5432/quickhire

# ── Strict-schema tables (typed repos) ─────────────────────────────────
PG_DRIVER_COUNTRIES=postgres
PG_DRIVER_CURRENCIES=postgres
PG_DRIVER_SERVICES=postgres
PG_DRIVER_USERS=postgres
PG_DRIVER_SESSIONS=postgres

# ── Generic-schema tables (mirror produced by pg-mirror-all.js) ────────
PG_DRIVER_BOOKINGS=postgres
PG_DRIVER_JOBS=postgres
PG_DRIVER_PAYMENTS=postgres
PG_DRIVER_PAYOUTS=postgres
PG_DRIVER_REFUNDS=postgres
PG_DRIVER_NOTIFICATIONS=postgres
PG_DRIVER_NOTIFICATION_TEMPLATES=postgres
PG_DRIVER_TICKETS=postgres
PG_DRIVER_TICKET_MESSAGES=postgres
PG_DRIVER_BOOKING_HISTORIES=postgres
PG_DRIVER_RESCHEDULE_HISTORY=postgres
PG_DRIVER_CHAT=postgres
PG_DRIVER_CHATBOT_LOGS=postgres
PG_DRIVER_REVIEWS=postgres
PG_DRIVER_TIPS=postgres
PG_DRIVER_GEO_PRICING=postgres
PG_DRIVER_FX_RATES=postgres
PG_DRIVER_PROMO_CODES=postgres
PG_DRIVER_PROMO_REDEMPTIONS=postgres
PG_DRIVER_AFFILIATE_COMMISSIONS=postgres
PG_DRIVER_FEATURE_FLAGS=postgres
PG_DRIVER_AUDIT_LOGS=postgres
PG_DRIVER_KYC_DOCUMENTS=postgres
PG_DRIVER_LEGAL_DOCUMENTS=postgres
PG_DRIVER_LEGAL_ACCEPTANCES=postgres
PG_DRIVER_BLOG_POSTS=postgres
PG_DRIVER_BLOG_CATEGORIES=postgres
PG_DRIVER_CMS_PAGES=postgres
PG_DRIVER_CMS_CONTENT=postgres
PG_DRIVER_CMS_BANNERS=postgres
PG_DRIVER_CMS_ARTICLES=postgres
PG_DRIVER_SEO_PAGES=postgres
PG_DRIVER_SEO_GLOBAL=postgres
PG_DRIVER_SEO_REDIRECTS=postgres
PG_DRIVER_RESOURCE_TIME_LOGS=postgres
PG_DRIVER_RESOURCE_DELIVERABLES=postgres
PG_DRIVER_RESOURCE_WORK_UPDATES=postgres
PG_DRIVER_STAFF_LEAVES=postgres
PG_DRIVER_TRANSLATIONS=postgres
PG_DRIVER_SYSTEM_CONFIG=postgres
PG_DRIVER_CARTS=postgres
PG_DRIVER_CONTACT_SUBMISSIONS=postgres

# ── Dual-write disabled (PG is the single writer) ──────────────────────
# PG_DUAL_WRITE=

# ─────────────────────────────────────────────────────────────────────────
# After deploying with these vars set:
#   • The Mongo container can be stopped (no connections will be opened).
#   • `mongodb` package can stay in dependencies until the next cleanup
#     pass since dualCollection.js still imports ObjectId for ID generation.
# ─────────────────────────────────────────────────────────────────────────
