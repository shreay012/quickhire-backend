JWT_ISSUER=quickhire.services
JWT_AUDIENCE=quickhire-api

# --- OTP / SMS (mock provider — no real SMS sent) ---
OTP_LENGTH=4
OTP_TTL_SECONDS=300
SMS_PROVIDER=mock
DEV_MASTER_OTP=1234

# --- Razorpay (test keys, replace if testing payment flow) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# --- Misc ---
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120
APP_VERSION=docker-dev

# --- Country scope (RBAC rollout flag) ---
# COUNTRY_SCOPE_MODE=off
