# ─── .env.docker.example ────────────────────────────────────────────
# Dev-only environment for `docker compose up` local stack.
# Copy to .env.docker (gitignored) before booting the api container:
#
#     cp .env.docker.example .env.docker
#     docker compose up -d
#
# DO NOT use these values in production. JWT keys below are throwaway
# dev keys checked into git; production must use your own.
# ────────────────────────────────────────────────────────────────────

# --- Server ---
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=*

# --- Database ---
# Hostnames refer to compose service names (mongo / postgres / redis),
# resolvable inside the compose network only.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=quickhire
PG_URL=postgres://quickhire:quickhire@postgres:5432/quickhire
REDIS_URL=redis://redis:6379

# --- Postgres routing ---
# All flags default to "mongo". Flip individual tables to "postgres"
# when you want to read from PG instead. Strict-schema tables
# (countries/currencies/services/users/sessions) are always served
# from Mongo by dualCol — their typed repos handle PG separately.
PG_DRIVER_COUNTRIES=mongo
PG_DRIVER_CURRENCIES=mongo
PG_DRIVER_SERVICES=mongo
PG_DRIVER_USERS=mongo
PG_DRIVER_SESSIONS=mongo
PG_DRIVER_BOOKINGS=mongo
PG_DRIVER_JOBS=mongo
PG_DRIVER_PAYMENTS=mongo
PG_DRIVER_NOTIFICATIONS=mongo
# Comma-list of tables to dual-write (Mongo + PG on every write).
# PG_DUAL_WRITE=countries,currencies,services,users,sessions,bookings,jobs,payments,notifications

